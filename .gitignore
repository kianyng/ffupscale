# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Build and packaging output
build/
build-*/
dist/
release/
release-folder/
*.spec
*.zip
*.7z
*.rar

# Local design source files and exports
assets/*.psd
assets/*.psb
assets/*.png

# Bundled FFmpeg executables are added locally when packaging
vendor/ffmpeg/bin/*.exe

# FFmpeg temporary, progress, and two-pass files
ffmpeg2pass-*.log
ffmpeg2pass-*.log.mbtree
*.part
*.tmp
*_upscaled*.mp4

# VS Code: ignore personal configuration but keep shared tasks
.vscode/*
!.vscode/tasks.json

# Other editors
.idea/
*.swp
*.swo

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
